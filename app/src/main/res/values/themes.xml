<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only needs to be an actionbar-less
         framework theme so no XML chrome appears behind the composition. -->
    <style name="Theme.LiftLog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
